# ~/.config/agentic-delivery/.env  (chmod 600; never commit it)
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# GitLab personal access token with scope read_api only. MRs are opened through push options.
GITLAB_TOKEN=
# GITLAB_URL=https://gitlab.example.com      # default: the host of `origin`
# GITLAB_INSECURE=1                          # self-hosted GitLab with a certificate that does not verify
# AI_REVIEW_BOT=code-review-bot
